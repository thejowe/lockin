{
  "expo": {
    "name": "lockin",
    "slug": "lockin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.lockin.mobile"
    },
    "android": {
      "package": "app.lockin.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "LockIn necesita la cámara para la llamada de vídeo de la sesión Lock-In.",
          "microphonePermission": "LockIn necesita el micrófono para la llamada de vídeo de la sesión Lock-In."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cd6e3675-5748-49ab-8500-72b3b3ed5779"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd6e3675-5748-49ab-8500-72b3b3ed5779"
      }
    },
    "owner": "thejowe"
  }
}
