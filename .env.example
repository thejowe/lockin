# Plantilla de variables de entorno de LockIn.
#
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` esta en .gitignore — nunca subas claves al repositorio.
#
#   cp .env.example .env.local
#
# Sin estas dos variables la app arranca contra el mock en memoria de
# `src/data/mock/`. Con ellas, contra Supabase. Lo decide `src/data/active.ts`.
#
# Origen de los valores (dashboard de Supabase):
#   EXPO_PUBLIC_SUPABASE_URL       Project Settings -> Data API -> Project URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY  Project Settings -> API Keys -> anon / public
#
# La URL es la raiz del proyecto (`https://<ref>.supabase.co`), NO el endpoint
# REST: pegar la variante con `/rest/v1/` da un 404 opaco en la primera consulta.
#
# La clave `anon` es publica por diseno: va embebida en el bundle del cliente y
# la seguridad real la imponen las politicas RLS de supabase/migrations/.
# La clave `service_role` NUNCA debe aparecer aqui ni en ningun archivo del app.

EXPO_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon
