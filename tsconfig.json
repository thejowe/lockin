{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },
    "types": ["jest", "node", "expo/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Las Edge Functions corren en Deno (`Deno`, imports `jsr:`): no son de la app.
  "exclude": ["node_modules", "supabase/functions"]
}
